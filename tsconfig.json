{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",                 // <- Changed
      "moduleResolution": "node",           // <- Changed
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "noImplicitAny": true,
      "sourceMap": true,
      "outDir": "dist",
      "baseUrl": ".",
      "paths": {
        "*": ["node_modules/*"]
      }
    },
    "include": ["src/**/*"]
  }
  